# Node.js dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environment
.venv/
ml-service/.venv/

# Python cache
__pycache__/
*.pyc
# Google Cloud credentials
key.json
*-key.json
gcp-key.json

# Terraform local configuration and secrets
terraform/terraform.tfvars
terraform/*.tfvars
!terraform/*.tfvars.example

# Terraform state and working files
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform/
terraform/crash.log
terraform/crash.*.log
